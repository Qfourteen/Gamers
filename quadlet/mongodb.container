[Unit]
Description=MongoDB 8
After=mongodb-data.volume gamers.network
Requires=mongodb-data.volume gamers.network

[Container]
Image=docker.io/library/mongo:8
ContainerName=mongo
Environment=MONGO_INITDB_ROOT_USERNAME=admin
Environment=MONGO_INITDB_ROOT_PASSWORD=adminpass
Volume=mongodb-data:/data/db
PublishPort=27017:27017
Network=systemd-gamers

[Service]
Restart=always

[Install]
WantedBy=default.target
