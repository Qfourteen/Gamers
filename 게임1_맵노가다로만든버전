# 메인 루프
world = World(tilemap, tile_images, TILE_SIZE)
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE and jump_count < max_jumps:
                y_vel = jump_power
                jump_count += 1
                jumping = True

        if event.type == pygame.KEYUP:
            if event.key == pygame.K_SPACE and y_vel < 0:
                y_vel *= jump_release_damping # 위로 튕기는 힘 감소

    keys = pygame.key.get_pressed()
    if keys[pygame.K_LEFT]:
        player.x -= speed
    if world.check_tile_collision(player, 0, 0):
        player.x += speed  # 충돌했으면 되돌림

    if keys[pygame.K_RIGHT]:
        player.x += speed
        if world.check_tile_collision(player, 0, 0):
            player.x -= speed  # 충돌했으면 되돌림

    # 중력 적용
    y_vel += gravity
    player.y += y_vel

    collision = world.check_tile_collision(player, 0, 0)
    if collision:
        if y_vel > 0:
            player.bottom = (player.bottom // TILE_SIZE) * TILE_SIZE
            y_vel = 0
            jump_count = 0
        elif y_vel < 0:
            player.top = (player.top // TILE_SIZE + 1) * TILE_SIZE
            y_vel = 0

    # ground_level 기반 바닥 충돌 (fallback)
    if player.bottom >= ground_level:
        player.bottom = ground_level
        y_vel = 0
        jump_count = 0

    
    screen.blit(background, (0, 0))  # 배경 이미지 그리기
    pygame.draw.rect(screen, (0, 255, 0), player)

    #draw_map()
    world.draw(screen)

    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()

